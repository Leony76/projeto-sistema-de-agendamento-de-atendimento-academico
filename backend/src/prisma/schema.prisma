
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  password     String
  photo        String?
  
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime?   @updatedAt      @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  role         UserRole   @map("user_role")  @default(STUDENT)  

  student      Student?
  professor    Professor?
  manager      Manager?

  @@map("users")
}

model Student {
  userId  Int    @unique @map("user_id")     
  ra      String @unique

  user    User @relation(fields: [userId], references: [id])

  appointments  Appointment[]  
  solicitations Solicitation[]  

  @@map("students")
}

model Professor {
  userId        Int  @unique       
  user          User @relation(fields: [userId], references: [id])
  
  disciplines   Discipline[]
  appointments  Appointment[]  
  solicitations Solicitation[]  
  availability  ProfessorAvailability[]

  @@map("professors")
}

model Manager {
  userId  Int  @unique      
  user    User @relation(fields: [userId], references: [id])
  
  @@map("managers")
}


model Room {
  id           Int        @id @default(autoincrement())
  name         String
  status       RoomStatus

  registeredAt DateTime  @default(now())  @map("registered_at")
  updatedAt    DateTime?   @updatedAt       @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")               

  appointments Appointment[]

  @@map("rooms")
}

model ProfessorAvailability {
  id           Int   @id @default(autoincrement())

  registeredAt  DateTime   @default(now()) @map("registered_at")
  updatedAt     DateTime?   @updatedAt      @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  startTime    Int
  endTime      Int 
  dayOfWeek    DayOfWeek   

  professorId  Int
  professor    Professor   @relation(fields: [professorId], references: [userId])

  @@map("professor_availabilities")
}

model Appointment {
  id         Int       @id  @default(autoincrement())
  reason     String
  dateTime   DateTime       @map("date_time")

  registeredAt  DateTime   @default(now()) @map("registered_at")
  updatedAt     DateTime   @updatedAt      @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  roomId       Int         
  room         Room         @relation(fields: [roomId], references: [id])

  studentId    Int          @map("student_id")
  student      Student      @relation(fields: [studentId], references: [userId]) 

  professorId  Int          @map("professor_id")
  professor    Professor    @relation(fields: [professorId], references: [userId]) 

  history      History?

  @@unique([professorId, dateTime])
  @@unique([roomId, dateTime])
  @@map("appointments")
}

model Solicitation {
  id         Int     @id         @default(autoincrement())
  dateTime   DateTime

  registeredAt  DateTime   @default(now()) @map("registered_at")
  updatedAt     DateTime?   @updatedAt      @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  status     SolicitationStatus  @default(UNCONFIRMED)

  studentId    Int          @map("student_id")
  student      Student      @relation(fields: [studentId], references: [userId]) 

  professorId  Int          @map("professor_id")
  professor    Professor    @relation(fields: [professorId], references: [userId])  

  @@map("solicitations")
}

model History {
  id Int        @id        @default(autoincrement())

  registeredAt  DateTime   @default(now()) @map("registered_at")
  updatedAt     DateTime?  @updatedAt      @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  appointmentId  Int           @unique
  appointment    Appointment   @relation(fields: [appointmentId], references: [id])

  @@map("history")
}

model Discipline {
  id           Int        @id @default(autoincrement())
  name         String

  registeredAt  DateTime   @default(now()) @map("registered_at")
  updatedAt     DateTime?  @updatedAt      @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  professorId  Int 
  professor    Professor  @relation(fields: [professorId], references: [userId])

  @@map("disciplines")
}

enum UserRole {
  STUDENT
  PROFESSOR
  MANAGER
}

enum SolicitationStatus {
  CONFIRMED
  UNCONFIRMED
  CANCELED
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  UNAVAILABLE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

