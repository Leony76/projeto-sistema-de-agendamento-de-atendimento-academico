
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int        @id @default(autoincrement())
  name                  String
  email                 String     @unique
  password              String
  hasTemporaryPassword  Boolean    @map("has_temporary_password") @default(false)
  photo                 String?
  
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt      @map("updated_at")
  deletedAt             DateTime?  @map("deleted_at")

  role                  UserRole   @map("role")  @default(STUDENT)  

  student               Student?
  professor             Professor?
  manager               Manager?

  @@map("users")
}

model Student {
  userId  Int    @unique @map("user_id")     
  ra      String @unique

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments  Appointment[]  

  @@map("students")
}

model Professor {
  userId        Int  @unique @map("user_id")       
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  disciplines   Discipline[]
  appointments  Appointment[]  
  availability  ProfessorAvailability[]

  @@map("professors")
}

model Manager {
  userId  Int  @unique @map("user_id")     
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("managers")
}


model Room {
  id             Int        @id @default(autoincrement())
  name           String
  status         RoomStatus

  registeredAt   DateTime   @default(now())  @map("registered_at")
  updatedAt      DateTime   @updatedAt       @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")               

  appointments   Appointment[]
  history        History[]

  @@map("rooms")
}

model ProfessorAvailability {
  id            Int         @id @default(autoincrement())
  registeredAt  DateTime    @default(now()) @map("registered_at")
  updatedAt     DateTime    @updatedAt      @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  startTime     Int
  endTime       Int 
  shift         Shift
  dayOfWeek     AvailableDay   

  professorId   Int
  professor     Professor   @relation(fields: [professorId], references: [userId], onDelete: Cascade)

  @@unique([professorId, dayOfWeek, shift])
  @@map("professors_availabilities")
}

model Appointment {
  id            Int       @id @default(autoincrement())

  reason        String
  dateTime      DateTime  @map("date_time")

  registeredAt  DateTime  @default(now()) @map("registered_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  status        AppointmentStatus @default(PENDING)

  roomId        Int?      @map("room_id")
  room          Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  studentId     Int       @map("student_id")
  student       Student   @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  professorId   Int       @map("professor_id")
  professor     Professor @relation(fields: [professorId], references: [userId], onDelete: Cascade)

  history       History?

  @@unique([roomId, dateTime])

  @@map("appointments")
}

model History {
  id Int         @id            @default(autoincrement())

  registeredAt   DateTime       @default(now())      @map("registered_at")
  updatedAt      DateTime       @updatedAt           @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  roomId         Int
  room           Room           @relation(fields: [roomId], references: [id])

  appointmentId  Int            @unique
  appointment    Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("history")
}

model Discipline {
  id            Int         @id @default(autoincrement())
  name          String

  registeredAt  DateTime    @default(now()) @map("registered_at")
  updatedAt     DateTime    @updatedAt      @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  professorId   Int?        @map("professor_id")
  professor     Professor?  @relation(fields: [professorId], references: [userId], onDelete: Cascade)

  @@map("disciplines")
}

enum UserRole {
  STUDENT
  PROFESSOR
  MANAGER
}

enum Shift {
  MORNING
  AFTERNOON
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  CONFIRMED
  CANCELED
  DONE
  NO_SHOW
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
}

enum AvailableDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

